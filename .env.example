# Copy this file to .env and fill in your own value. Never commit .env.

# GitHub Personal Access Token, read-only usage only.
# A classic PAT with NO scopes selected is enough right now: it can still
# read public repositories, and merely authenticating raises your REST API
# rate limit from 60/hour to 5000/hour. Create one at:
# https://github.com/settings/tokens
#
# Only add the "repo" scope (or switch to a fine-grained PAT scoped to
# specific repositories with read-only Actions/Contents/Metadata
# permissions) if you need to read PRIVATE repositories later.
GITHUB_TOKEN=
